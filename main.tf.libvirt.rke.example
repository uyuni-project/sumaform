terraform {
 required_version = ">= 1.6.0"
 required_providers {
   libvirt = {
     source = "dmacvicar/libvirt"
     version = "0.8.3"
   }
 }
}

provider "libvirt" {
  uri = "qemu:///system"
}


module "cucumber_testsuite" {
  source = "./modules/cucumber_testsuite"

  # see https://github.com/uyuni-project/sumaform/blob/master/README_ADVANCED.md
  # for more information on product_version values
  # you should use the same version here as in git_repo below
  # if you work on Uyuni you should use e.g. uyuni-master here and uyuni as git_repo below
  product_version = "uyuni-master"

  # SUSE SCC credentials
  cc_username = ""
  cc_password = ""

  # SUSE SCC credentials with PTFs available
  cc_ptf_username = ""
  cc_ptf_password = ""

  # RKE2 / Kubernetes variables
  kubernetes                     = true
  use_devel_oci                  = true
  deploy_coco_attestation        = true
  deploy_saline                  = true
  deploy_tftp                    = true
  deploy_hub_api                 = true
  rke2_version                   = "v1.35.4+rke2r1"

  # true to install the server and proxy on RKE2. False if you want to use an external cluster.
  install_uyuni_via_testsuite    = true

  # true to install kubectl and helm on the controller
  install_kubectl_helm           = false

  # path to an existing kubeconfig to copy to /root/.kube/config on the
  # controller, e.g. when reusing an existing (external) Kubernetes cluster
  # via the kubernetes_cluster_mode variable (see modules/cucumber_testsuite)
  # Modify it just if you want to use an external cluster not deployed by the testsuite. Null by default.
  kubeconfig_path                = null

  # Uncomment to pin a different cert-manager release, defaults shown below
  # cert_manager_version          = "v1.19.2"
  # cert_manager_namespace        = "cert-manager"

  # Uncomment to create spacewalk and pgsql as static PVs, false by default. Otherwise they are managed by the storage backend.
  # kubernetes_create_static_var_spacewalk_pv = true
  # kubernetes_create_static_var_pgsql_pv     = true

  # Uncomment to set the local_path_provisioner as local_path. True by deefault.
  # local_path_provisioner_default_class      = true

  # define what images should be used and uploaded
  # https://github.com/uyuni-project/sumaform/blob/master/backend_modules/libvirt/README.md#only-upload-a-subset-of-available-images
  # the following images are e.g. available:
  # "almalinux8o", "almalinux9o", "almalinux10o",
  # "amazonlinux2023o",
  # "centos7", "centos7o", "centos8o", "centos9o",
  # "debian13o",
  # "libertylinux9o", "libertylinux10o",
  # "openeuler2403o",
  # "opensuse160o", "opensuse161armo",
  # "oraclelinux8o", "oraclelinux9o", "oraclelinux10o",
  # "raspios13o",
  # "rocky8o", "rocky9o", "rocky10o",
  # "sles12sp5o", "sles15sp4o", "sles15sp5o", "sles15sp6o", "sles15sp7o", "sles160o",
  # "slemicro53-ign", "slemicro54-ign", "slemicro55o",
  # "slmicro60o", "slmicro61o", "slmicro62o",
  # "suma43VM-ign",
  # "tumbleweedo",
  # "ubuntu2204o", "ubuntu2404o", "ubuntu2604o"
  # to see what VM uses what image, have a look at the image variable in the cucumber_module definition
  # https://github.com/uyuni-project/sumaform/blob/master/modules/cucumber_testsuite/main.tf
  # images = ["rocky9o", "opensuse160o", "sles15sp4o", "ubuntu2204o", "tumbleweedo"]

  use_avahi = true
  name_prefix = "prefix-"
  domain = "tf.local"
  from_email = "email@domain.com"

  # git credentials and repository that will be checked out on the controller
  # you have to use a personal access token as password and not your actual GitHub password
  # see https://github.com/settings/tokens
  # here you can specify a branch where you e.g. develop a new test
  # be aware to use the same version (e.g. Uyuni or SUMA) as git_repo as set in product_version above
  git_repo = "https://github.com/uyuni-project/uyuni.git"
  git_username = "nogit"
  git_password = "nogit"
  branch = "master"

  # With kubernetes = true above, the server and proxy are always deployed on
  # Kubernetes regardless of these two; kept here for parity with CI configs
  # that toggle between containerized and Kubernetes deployments.
  container_server = true
  container_proxy  = true

  # In case you use an authentication registry
  auth_registry = "registry.mgr.suse.de:5000/cucutest"
  auth_registry_username = ""
  auth_registry_password = ""
  git_profiles_repo = "https://github.com/uyuni-project/uyuni.git#:testsuite/features/profiles/internal_slc"

  # define which VMs should be created and adjust their settings.
  # if you do not need a minion just comment it out.
  # example:
  # suse_minion = {
  #    image = "sles15sp4o"
  #    name = "minion"
  #    provider_settings = {
  #      mac = "aa:bb:cc:dd:ee:ff"
  #      memory = 1024
  #      vcpu = 2
  #    }
  #    additional_repos = {
  #      Test_repo = "http://dist.suse.de/ibs/Devel:/Galaxy:/Manager:/TEST/SLE_15_SP4/"
  #    }
  #    additional_packages = [ "vim" ]
  # }
  # also have a look at the image matrix that is used in our test suite:
  # https://github.com/SUSE/susemanager-ci#used-image-versions-in-the-ci-test-suite
  # The following modules are just to configure the machines, to actually install RKE2
  #  and the server/proxy you need to execute some run_sets as is described in this README: https://github.com/uyuni-project/sumaform/blob/master/salt/server_kubernetes/README.md
  host_settings = {
    # IMPORTANT!!
    # The controller is mandatory because the RKE2 and the server/proxy are installed via testsute. 
    controller = {
      name = "controller"
    }
    server_kubernetes = {
      # image = "slmicro62o" or "tumbleweedo". It's slmicro 6.2 by default.
      # Define name of the server. Uyuni-server by default.
      server_name = "uyuni-server"

      # Define name of the server namespace. Uyuni by default.
      server_namespace = "uyuni"

      # Kubernetes distro to run the container in.
      # runtime = "rke2"

      # Where to get the containers from; the module's own default points at
      # an internal SUSE registry, so override it for a public setup
      container_registry = "registry.opensuse.org/systemsmanagement/uyuni/master/containerfile/uyuni"

      # Name of the helm chart. The last string of the OCI url.
      helm_chart_name = "server-helm"

      # Helm oci; the module's own default points at an internal SUSE chart
      # repository, so override it for a public setup
      helm_chart_url = "oci://registry.opensuse.org/systemsmanagement/uyuni/master/charts/uyuni"

      # Define a specific container image tag to install
      container_tag = "latest"

      # Override the default image names for Server and Database containers
      # container_image = "server"
      # db_container_image = "server-postgresql"

      # The Kubernetes server needs considerably more resources than a plain
      # VM or container host; adjust to your hardware, these are a sane start
      # provider_settings = {
      #   vcpu   = 8
      #   memory = 32768
      # }
      # main_disk_size       = 40
      # repository_disk_size = 300
      # database_disk_size   = 60
      # login_timeout        = 28800
    }
    proxy_kubernetes = {
      # image = "slmicro62o" or "tumbleweedo". It's slmicro 6.2 by default.
      
      # Define name of the proxy. Uyuni-proxy by default.
      proxy_name = "uyuni-proxy"

      # Define name of the proxy namespace. Uyuni by default.
      proxy_namespace = "uyuni"

      # runtime defaults to "rke2" already, no need to set it explicitly

      # Where to get the containers from; the module's own default points at
      # an internal SUSE registry, so override it for a public setup
      container_registry = "registry.opensuse.org/systemsmanagement/uyuni/master/containerfile/uyuni"

      # Name of the helm chart. The last string of the OCI url.
      helm_chart_name = "proxy-helm"

      # Helm oci; the module's own default points at an internal SUSE chart
      # repository, so override it for a public setup
      helm_chart_url = "oci://registry.opensuse.org/systemsmanagement/uyuni/master/charts/uyuni"

      # Define a specific container image tag to install
      container_tag = "latest"

      # Override the default image names for Server and Database containers
      # container_image = "server"
      # db_container_image = "server-postgresql"

      # adjust to your hardware, these are a sane start
      # provider_settings = {
      #   vcpu   = 2
      #   memory = 16384
      # }
      # login_timeout = 28800
    }
    suse_client = {
      image = "sles15sp4o"
    }
    suse_minion = {
      image = "sles15sp4o"
      name = "minion"
    }
    suse_sshminion = {
      image = "sles15sp4o"
      name = "sshminion"
    }
    rhlike_minion = {
      image = "centos7o"
      name = "centos"
    }
    deblike_minion = {
      image = "ubuntu2204o"
      name = "ubuntu"
    }
    build_host = {
      image = "sles15sp4o"
      name = "build"
    }
    pxeboot_minion = {
      image = "sles15sp4o"
      name = "pxeboot"
    }
    kvm_host = {
      image = "opensuse160o"
      name = "kvmhost"
    }
    monitoring_server = {
      image = "sles15sp4o"
      name = "monitoring"
    }
  }

  # special settings for adjusting e.g. the pool name or defining another IP range
  #provider_settings = {
  #  uri = "qemu:///system"
  #  pool = "username_disks"
  #  bridge = "br0"
  #}
}

# This will generate the outputs on-screen and will store them in the terraform.tfstate file
output "configuration" {
  sensitive = true
  value     = module.cucumber_testsuite.configuration
}
