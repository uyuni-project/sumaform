# UBI 7 ships openssh-server but not its dependencies (fipscheck, tcp_wrappers-libs),
# and carries no hostname, logrotate, policycoreutils or iproute at all. CentOS 7 fills the gaps.
# UBI 8, 9 and 10 need none of this, their own repositories are complete.
[centos7-os]
name=CentOS 7 - Base
baseurl=https://vault.centos.org/7.9.2009/os/x86_64/
gpgcheck=1
gpgkey=https://vault.centos.org/7.9.2009/os/x86_64/RPM-GPG-KEY-CentOS-7
enabled=1

[centos7-updates]
name=CentOS 7 - Updates
baseurl=https://vault.centos.org/7.9.2009/updates/x86_64/
gpgcheck=1
gpgkey=https://vault.centos.org/7.9.2009/os/x86_64/RPM-GPG-KEY-CentOS-7
enabled=1

[centos7-extras]
name=CentOS 7 - Extras
baseurl=https://vault.centos.org/7.9.2009/extras/x86_64/
gpgcheck=1
gpgkey=https://vault.centos.org/7.9.2009/os/x86_64/RPM-GPG-KEY-CentOS-7
enabled=1
